# SQL Server connection
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=false

# Paths
RULES_DIR=./rules
REPORTS_DIR=./reports
PRESETS_DIR=./presets

# Streaming — rows per keyset chunk (lower = less RAM, more round-trips)
CHUNK_SIZE=5000

# Worker threads — set to CPU count - 1; in Docker set to match container CPU limit
MAX_WORKER_THREADS=4

NODE_ENV=development
