# SQL Server — source and target migration databases (read-only)
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=false

# PostgreSQL — app database (job persistence + validation cache tables)
CACHE_DB_HOST=
CACHE_DB_PORT=5432
CACHE_DB_USER=
CACHE_DB_PASSWORD=
CACHE_DB_NAME=postgres

# Paths
RULES_DIR=./rules
REPORTS_DIR=./reports
PRESETS_DIR=./presets

# Streaming — rows per keyset chunk (lower = less RAM, more round-trips)
CHUNK_SIZE=5000

# Worker threads — set to CPU count - 1; in Docker set to match container CPU limit
MAX_WORKER_THREADS=4

NODE_ENV=development
