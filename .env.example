# SQL Server connection
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

# Paths
RULES_DIR=./rules
REPORTS_DIR=./reports

# Streaming — rows per keyset chunk (lower = less RAM, more round-trips)
CHUNK_SIZE=5000

NODE_ENV=development

# JWT auth
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=8h
API_USERNAME=vidar
API_PASSWORD=change-me
